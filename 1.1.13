#include <stdio.h>
#include <limits.h>

#define MAX 20

int n;
int cost[MAX][MAX];
int visited[MAX];
int minCost = INT_MAX;

void tsp(int current, int count, int totalCost)
{
	// All cities have been visited
	if (count == n)
	{
		// Return to starting city (0)
		if (cost[current][0] != -1)
		{
			int finalCost = totalCost + cost[current][0];

			if (finalCost < minCost)
				minCost = finalCost;
		}
		return;
	}

	// Try visiting every unvisited city
	for (int next = 0; next < n; next++)
	{
		if (!visited[next] && cost[current][next] != -1)
		{
			visited[next] = 1;

			tsp(next, count + 1,
				totalCost + cost[current][next]);

			visited[next] = 0;
		}
	}
}

int main()
{
	scanf("%d", &n);

	for (int i = 0; i < n; i++)
	{

		for (int j = 0; j < n; j++)
		{
			scanf("%d", &cost[i][j]);
		}
	}

	// Start from city 0
	visited[0] = 1;

	tsp(0, 1, 0);

	printf("%d\n", minCost);

	return 0;
}
